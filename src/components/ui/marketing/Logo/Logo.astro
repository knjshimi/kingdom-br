---
import { siteConfig } from "../../../../config/site.config";

export interface Props {
  href?: string;
}

const { href = "/" } = Astro.props as Props;
const { light, dark } = siteConfig.branding.logo;
---

<a href={href} class="ui-logo" aria-label={siteConfig.name}>
  <img
    src={light}
    alt=""
    width="980"
    height="300"
    class="ui-logo__img ui-logo__img--light"
  />
  <img
    src={dark}
    alt=""
    width="980"
    height="300"
    class="ui-logo__img ui-logo__img--dark"
    aria-hidden="true"
  />
</a>

<style>
  .ui-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .ui-logo__img {
    display: block;
    height: var(--spacing-7);
    width: auto;
  }

  .ui-logo__img--dark {
    display: none;
  }

  :global(.dark) .ui-logo__img--light {
    display: none;
  }

  :global(.dark) .ui-logo__img--dark {
    display: block;
  }
</style>
