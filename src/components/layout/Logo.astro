---
import { siteConfig } from "../../config/site.config";
export interface Props {
  href?: string;
}

const { href = "/" } = Astro.props as Props;
const { light, dark } = siteConfig.branding.logo;
---

<a href={href} class="logo" aria-label={siteConfig.name}>
  <img
    src={light}
    alt=""
    width="980"
    height="300"
    class="logo__img logo__img--light"
  />
  <img
    src={dark}
    alt=""
    width="980"
    height="300"
    class="logo__img logo__img--dark"
    aria-hidden="true"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .logo:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .logo__img {
    display: block;
    height: var(--spacing-7);
    width: auto;
  }

  .logo__img--dark {
    display: none;
  }

  :global(.dark) .logo__img--light {
    display: none;
  }

  :global(.dark) .logo__img--dark {
    display: block;
  }
</style>
